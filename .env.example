DATABASE_URL=data/coruscant.db
GEMINI_API_KEY=
# Optional: Modell überschreiben (Standard: gemini-3.6-flash, Fallback: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Lokale Dev-Ports: Coruscant läuft auf 3000, finanz_cockpit auf 3001
FINANZ_COCKPIT_URL=http://localhost:3001
FINANZ_COCKPIT_PUBLIC_URL=http://localhost:3001
FINANZ_COCKPIT_SYNC_INTERVAL_MINUTES=15
EXTERNAL_SUMMARY_TOKEN=
# Optional: Dev-Dummy-Modus für Modus B (auto | true | false; Default: auto in Non-Production)
CORUSCANT_HOUSEHOLD_DUMMY=auto
